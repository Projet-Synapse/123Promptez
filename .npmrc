# React Native's bundler (invoked directly by Gradle for Android builds,
# outside Metro's own resolver) uses plain Node module resolution and
# expects to find every dependency by walking up through node_modules —
# pnpm's default symlinked/isolated layout doesn't expose transitive
# dependencies that way, which breaks with "Cannot find module
# 'babel-preset-expo'" during `gradlew assembleRelease`. Hoisted linking
# gives a flat node_modules layout compatible with React Native's tooling.
# This is Expo's own documented recommendation for using pnpm.
node-linker=hoisted
